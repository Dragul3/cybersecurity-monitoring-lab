<!-- Custom Wazuh rules developed during the cybersecurity monitoring project -->

<group name="suricata,custom,ids,">

  <rule id="100200" level="6">
    <if_sid>86601</if_sid>
    <match>ET SCAN</match>
    <description>Suricata: network scan detected</description>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <rule id="100201" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100200</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Suricata: repeated scan activity from same source IP</description>
    <mitre>
      <id>T1595</id>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100202" level="8">
    <if_sid>86601</if_sid>
    <regex>Suspicious inbound to MSSQL port 1433|Suspicious inbound to mySQL port 3306|Suspicious inbound to PostgreSQL port 5432|SSH|RDP|3389|port 22</regex>
    <description>Suricata: scan against critical service</description>
    <mitre>
      <id>T1595</id>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100203" level="12">
    <if_sid>86601</if_sid>
    <regex>ET MALWARE</regex>
    <description>Suricata: malware-related network activity detected</description>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <rule id="100204" level="12">
    <if_sid>86601</if_sid>
    <regex>ET TROJAN|ET CNC|ET .*CnC|ET .*Command and Control</regex>
    <description>Suricata: possible command and control activity</description>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

  <rule id="100205" level="11">
    <if_sid>86601</if_sid>
    <regex>ET EXPLOIT|Exploit|CVE</regex>
    <description>Suricata: possible exploit attempt detected</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100206" level="10">
    <if_sid>86601</if_sid>
    <regex>ET PHISHING|Phishing</regex>
    <description>Suricata: possible phishing activity detected</description>
    <mitre>
      <id>T1566</id>
    </mitre>
  </rule>

  <rule id="100207" level="10">
    <if_sid>86601</if_sid>
    <regex>Discord WebHook|Discord Webhook|Exfil via Discord|Discord Token|Discord Grabber</regex>
    <description>Suricata: suspicious Discord webhook/exfiltration activity</description>
    <mitre>
      <id>T1567</id>
    </mitre>
  </rule>

  <rule id="100209" level="12" frequency="3" timeframe="300">
    <if_matched_sid>100202</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Suricata: repeated scan against critical services from same source IP</description>
    <mitre>
      <id>T1595</id>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100210" level="12">
    <if_sid>86601</if_sid>
    <match>MISP IOC Match - IP Reputation</match>
    <description>CTI: MISP IOC match detected by Suricata</description>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>

</group>

<group name="suricata,suppression,">

  <rule id="100500" level="0">
    <if_sid>86601</if_sid>
    <match>ET DOS Possible SSDP Amplification Scan in Progress</match>
    <description>Suppress: internal SSDP noise</description>
  </rule>

</group>

<group name="active-response,misp,cti,">

  <rule id="100220" level="10">
    <match>MISP AR BLOCKED</match>
    <description>Active Response: MISP IOC automatically blocked</description>
    <mitre>
      <id>T1562</id>
    </mitre>
  </rule>

</group>

<group name="cti,abuseipdb,enrichment,">

  <rule id="100230" level="5">
    <match>ABUSEIPDB enrichment</match>
    <description>CTI enrichment: AbuseIPDB reputation lookup completed</description>
  </rule>

  <rule id="100231" level="10">
    <match>ABUSEIPDB enrichment</match>
    <regex>score=(7[0-9]|8[0-9]|9[0-9]|100)</regex>
    <description>CTI enrichment: AbuseIPDB high confidence malicious IP</description>
  </rule>

</group>
