<group name="suricata,custom,network_scan">

  <!--
    Correlates multiple Suricata events from the same source IP
    within a short time window.

    Purpose:
    Detect repeated scanning activity and raise a higher-level alert.
  -->

  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_group>suricata</if_group>
    <same_source_ip />
    <description>Possible network scan detected from repeated Suricata events</description>

    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

</group>
